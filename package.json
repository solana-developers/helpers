{
  "name": "@solana-developers/helpers",
  "version": "3.0.0",
  "description": "Solana helper functions for web3.js version 3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "rm -rf dist",
    "validator": "solana-test-validator --reset --url devnet --clone-upgradeable-program ancA4duevpt3eSgS5J7cD8oJntmfLKJDM59GhMtegES",
    "typecheck": "tsc --noEmit && cd tests && npm run test:typecheck",
    "test": "cd tests && npm run test",
    "test:require": "node scripts/check-require.cjs",
    "test:ci": "npm run typecheck && npm run build && npm run test && npm run test:require"
  },
  "keywords": [
    "solana",
    "blockchain",
    "secret key",
    "private key",
    "web3.js",
    "kit",
    "keypair",
    "devnet SOL",
    "faucet"
  ],
  "author": "Mike MacCana <mike.maccana@solana.org>",
  "contributors": [
    "Nick Frostbutter",
    "John Liu",
    "Steven Luscher",
    "Christian Krueger",
    "Ayush Chauhan"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/solana-developers/helpers.git"
  },
  "homepage": "https://github.com/solana-developers/helpers",
  "bugs": {
    "url": "https://github.com/solana-developers/helpers/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@codama/dynamic-codecs": "^1.3.0",
    "@codama/nodes": "^1.11.0",
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/visitors-core": "^1.11.0",
    "@solana-program/program-metadata": "^0.10.1",
    "@solana-program/token-2022": "^0.20.0",
    "@solana/kit": "^8.5.0",
    "@solana/web3.js": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.5",
    "prettier": "^3.0.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
