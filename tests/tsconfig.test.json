// Typechecks the tests, which tsx runs directly
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    // The tests import the helpers from '../../src', which tsx resolves
    "moduleResolution": "bundler",
    "rootDir": "../",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["../src/**/*", "src/**/*"]
}
